{
    "$schema"  : "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name"     : "pony",
    "version"  : "0.0.1",
    "scopeName": "source.pony",
    "fileTypes": [".ini", ".f"],
    "patterns": [
        {"include": "#comment"},
        {"include": "#command"},
        {"include": "#label"},
        {"include": "#string"},
        {"include": "#keyword"},
        {"include": "#type"},
        {"include": "#var"},
        {"include": "#expression"}
    ],
    "repository": {
        "comment": {
            "patterns": [
                {
                    "name" : "comment.shebang.pony",
                    "match": "#!.*"
                },
                {
                    "name" : "comment.line.pony",
                    "match": "//.*"
                },
                {
                    "name" : "comment.block.pony",
                    "begin": "/[*]",
                    "end"  : "[*]/"
                },
                {
                    "name" : "comment.stack.pony",
                    "begin": "[(]",
                    "end"  : "[)]"
                }
            ]
        },
        "command": {
            "patterns": [
                {
                    "name" : "keyword.mnemonic.pony.assembly",
                    "match": "\\b(nop|halt|jmp|qjmp)\\b"
                }
            ]
        },
        "label": {
            "patterns": [
                {
                    "name": "variable.label.pony.public",
                    "match": "^:\\s*[a-z]+"
                },
                {
                    "name": "string.label.pony.local",
                    "match": "^[a-z]+:"
                }
            ]
        },
        "keyword": {
            "name": "keyword.control.pony",
            "match": "\\b(nop|halt)\\b"
        },
        "type": {
            "name": "constant.language.pony",
            "match": "\\b(char|int)\\b"
        },
        "var": {
            "name": "storage.type.pony",
            "match": "\\b(let)\\b"
        },
        "string": {
            "name": "string.quoted.double.pony",
            "begin": "\"",
            "beginCaptures": {
                "0": {"name": "punctuation.definition.string.begin.pony"}
            },
            "end": "\"",
            "endCaptures": {
                "0": {"name": "punctuation.definition.string.end.pony"}
            },
            "patterns": [
                {"include": "#string_escaped_char"}
            ]
        },
        "string_escaped_char": {
            "patterns": [
                {
                    "match": "(?x)\\\\ (\n\\\\\t\t\t |\n[abefnprtv'\"?]   |\n[0-3]\\d{,2}\t |\n[4-7]\\d?\t\t|\nx[a-fA-F0-9]{,2} |\nu[a-fA-F0-9]{,4} |\nU[a-fA-F0-9]{,8} )",
                    "name": "constant.character.escape.pony"
                },
                {
                    "match": "\\\\.",
                    "name": "invalid.illegal.unknown-escape.pony"
                }
            ]
        },
        "expression": {
            "patterns": [
                {"include": "#string"},
                {"include": "#number"},
                {"include": "#paren-expression"},
                {"include": "#quad-expression"}
            ]
        },
        "paren-expression": {
            "name": "expression.group",
            "begin": "\\(",
            "end": "\\)",
            "patterns": [
                {"include": "#type"},
                {"include": "#expression"}
            ]
        },
        "quad-expression": {
            "name": "expression.group",
            "begin": "\\[",
            "end": "\\]",
            "patterns": [
                {"include": "#number"}
            ]
        },
        "number": {
            "name": "constant.numeric.pony",
            "match": "[+-]?(0x[0-9A-Fa-f]+|0b[01]+|[0-9]+)([eE][+-]?[0-9]+)?"
        }
    }
}
